# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pharmacy_pos
DB_USER=root
DB_PASSWORD=1234

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-random-string
JWT_EXPIRE=24h
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this-in-production
JWT_REFRESH_EXPIRE=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Security
BCRYPT_ROUNDS=10

# Logging
LOG_LEVEL=info
